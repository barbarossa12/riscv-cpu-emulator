# Kernel options for the riscv-emu machine, merged over arch/riscv/configs/defconfig.

# 32-bit (the same four lines as arch/riscv/configs/32-bit.config).
CONFIG_ARCH_RV32I=y
CONFIG_32BIT=y
# CONFIG_PORTABLE is not set
CONFIG_NONPORTABLE=y

# One hart, no FPU, no vector unit, no modules.
# CONFIG_SMP is not set
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_MODULES is not set

# Console: the 16550 UART (ttyS0) through the device tree, and the SBI console for early output.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_HVC_RISCV_SBI=y

# Interrupts and time: the PLIC, and the timer through the SBI.
CONFIG_SIFIVE_PLIC=y

# The root filesystem is an initramfs.
CONFIG_BLK_DEV_INITRD=y

# Hardware this machine does not have.
# CONFIG_PCI is not set
# CONFIG_NET is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_VIRTIO_MMIO is not set

# Things the default config enables that this machine does not have or need. Each one costs boot time (the
# raid6 and xor benchmarks, for instance, run at every boot) and image size.
# CONFIG_KVM is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_MD is not set
# CONFIG_SCSI is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_I2C is not set
# CONFIG_INPUT is not set
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_EFI is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_RISCV_PMU_SBI is not set
